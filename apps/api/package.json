      "@prisma/client": "^6.1.0",
      "@types/node": "^22.10.2",
      "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "tsx": "^4.19.2"
  }
