{
  "name": "stackbuilder",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "corepack pnpm --filter web dev",
    "dev:renderer": "corepack pnpm --filter renderer dev",
    "dev:api": "corepack pnpm --filter api dev",
    "build": "corepack pnpm db:generate && corepack pnpm -r --if-present build",
    "build:render-one": "corepack pnpm db:generate && corepack pnpm --filter api build && corepack pnpm --filter web build && corepack pnpm --filter renderer build",
    "start:render-one": "node scripts/render-one-service.mjs",
    "lint": "corepack pnpm -r --if-present lint",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "test": "corepack pnpm -r --if-present test",
    "test:e2e": "corepack pnpm -r --if-present test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "infra:up": "docker compose -f docker-compose.yml up -d",
    "infra:down": "docker compose -f docker-compose.yml down"
  },
  "dependencies": {
    "prisma": "^6.1.0",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@prisma/client": "^6.1.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
