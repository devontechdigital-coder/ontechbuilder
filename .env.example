# Object storage
# Production uses Google Cloud Storage. Local development can use OBJECT_STORAGE_DRIVER=local
# for signed upload authorization simulation only; persistent user uploads must use GCS.
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_BUCKET=stackbuilder-dev
OBJECT_STORAGE_SIGNED_URL_EXPIRES_IN_SECONDS=300
GCS_PROJECT_ID=
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY=
GCS_CREDENTIALS_FILE=
LOCAL_SIGNED_UPLOAD_BASE_URL=http://localhost:4000/dev/storage
# Images default to 10 MB; general files default to 20 MB.
MEDIA_UPLOAD_MAX_IMAGE_BYTES=10000000
MEDIA_UPLOAD_MAX_FILE_BYTES=20000000
MEDIA_UPLOAD_MAX_BYTES=20000000
MEDIA_UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf

# Security
SESSION_SECRET=replace-with-at-least-32-characters
SESSION_COOKIE_NAME=stackbuilder_session
SESSION_TTL_DAYS=7
